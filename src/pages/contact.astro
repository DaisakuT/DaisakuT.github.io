---
import Base from '../layouts/Base.astro';

// Formspreeで新しく作ったフォームのIDに書き換えてください。
// 管理画面に表示される https://formspree.io/f/●●●●●●●● の●部分です。
const FORM_ID = 'mrpzjoly';

const endpoint = `https://formspree.io/f/${FORM_ID}`;
const thanksUrl = new URL('/thanks/', Astro.site).href;
---
<Base title="お問い合わせ" description="記事へのご指摘、取材・掲載のご依頼などはこちらからお願いします。">
  <div class="wrap article">
    <header class="article__head">
      <h1 class="article__title">お問い合わせ</h1>
    </header>
    <div class="prose">
      <p>
        記事内容へのご指摘、取材・掲載のご依頼、その他のご連絡はこちらからお送りください。
        2営業日以内に返信いたします。
      </p>

      <form class="form" action={endpoint} method="POST">
        <input type="hidden" name="_next" value={thanksUrl} />
        <input type="hidden" name="_subject" value="ブログからのお問い合わせ" />
        <label class="form__row">
          <span class="form__label">お名前 <em>必須</em></span>
          <input class="form__input" type="text" name="お名前" required autocomplete="name" />
        </label>

        <label class="form__row">
          <span class="form__label">メールアドレス <em>必須</em></span>
          <input class="form__input" type="email" name="email" required autocomplete="email" />
        </label>

        <label class="form__row">
          <span class="form__label">ご用件 <em>必須</em></span>
          <select class="form__input" name="ご用件" required>
            <option value="">選択してください</option>
            <option value="記事内容へのご指摘・訂正依頼">記事内容へのご指摘・訂正依頼</option>
            <option value="取材・掲載のご依頼">取材・掲載のご依頼</option>
            <option value="商品・サービスについて">商品・サービスについて</option>
            <option value="その他">その他</option>
          </select>
        </label>

        <label class="form__row">
          <span class="form__label">内容 <em>必須</em></span>
          <textarea class="form__input" name="内容" rows="7" required></textarea>
        </label>

        <button class="button" type="submit">送信する</button>
      </form>

      <h2>記事の誤りを見つけた場合</h2>
      <p>
        該当する記事のタイトルと、気になった箇所をお知らせください。
        確認のうえ、必要があれば記事を修正し、修正した旨を記載します。
      </p>
    </div>
  </div>
</Base>
