---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { SITE } from '../site.ts';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// 「記録の帯」を描くために、全記事が参照している記録の全期間を求める
const years = posts
  .flatMap((p) => [p.data.sourceFrom, p.data.sourceTo])
  .filter(Boolean)
  .map((d) => new Date(d).getTime())
  .filter((t) => !isNaN(t));

const spanStart = years.length ? Math.min(...years) : 0;
const spanEnd = years.length ? Math.max(...years) : 0;
const spanWidth = spanEnd - spanStart || 1;

const pct = (d) => ((new Date(d).getTime() - spanStart) / spanWidth) * 100;
const fmt = (d) => new Date(d).toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' });
const ym = (d) => new Date(d).toLocaleDateString('ja-JP', { year: 'numeric', month: 'short' });

const totalSources = posts.reduce((n, p) => n + (p.data.sourceCount || 0), 0);
---

<Base>
  <section class="wrap intro">
    <p class="intro__lede">{SITE.description}</p>
    <p class="intro__note">
      行った場所、食べたもの、そのとき考えたこと。書き残してきた記録を、あとから読み返せる形にまとめ直しています。
    </p>
    {totalSources > 0 && (
      <p class="intro__stat">
        記事 {posts.length} 本 ／ もとにした記録 {totalSources} 件
      </p>
    )}
  </section>

  <div class="wrap">
    <ul class="list">
      {posts.map((post) => (
        <li class="entry">
          <span class="entry__date">{fmt(post.data.pubDate)}</span>
          <h2 class="entry__title">
            <a href={`/blog/${post.id}/`}>{post.data.title}</a>
          </h2>
          <p class="entry__desc">{post.data.description}</p>

          {post.data.sourceFrom && post.data.sourceTo && spanEnd > spanStart && (
            <div class="record">
              <div class="record__track">
                <span
                  class="record__span"
                  style={`left:${pct(post.data.sourceFrom)}%; width:${Math.max(pct(post.data.sourceTo) - pct(post.data.sourceFrom), 1.5)}%`}
                ></span>
              </div>
              <span class="record__label">
                {new Date(post.data.sourceFrom).getFullYear()}年 〜 {new Date(post.data.sourceTo).getFullYear()}年の記録より
              </span>
            </div>
          )}
        </li>
      ))}
    </ul>

    {posts.length === 0 && (
      <p style="padding:3rem 0;">まだ記事がありません。Actions タブから「記事の自動生成」を実行すると、ここに並びます。</p>
    )}
  </div>
</Base>
