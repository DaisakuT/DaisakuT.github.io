---
import { SITE } from '../site.ts';
import '../styles/global.css';

const { title, description, article = false } = Astro.props;
const pageTitle = title ? `${title} | ${SITE.title}` : `${SITE.title} — ${SITE.tagline}`;
const pageDesc = description || SITE.description;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {SITE.gaId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.gaId}`}></script>
        <script is:inline define:vars={{ gaId: SITE.gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}

    {SITE.adsenseClient && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${SITE.adsenseClient}`}
        crossorigin="anonymous"
      ></script>
    )}
  </head>
  <body>
    <header class="masthead">
      <div class="wrap masthead__inner">
        <p class="masthead__title"><a href="/">{SITE.title}</a></p>
        <span class="masthead__tagline">{SITE.tagline}</span>
        <nav class="nav">
          <a href="/">記事</a>
          <a href="/about/">運営者</a>
          <a href="/contact/">お問い合わせ</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap footer__inner">
        <span>&copy; {new Date().getFullYear()} {SITE.title}</span>
        <a href="/privacy/">プライバシーポリシー</a>
        <a href="/contact/">お問い合わせ</a>
        <a href="/rss.xml">RSS</a>
      </div>
    </footer>
  </body>
</html>
