---
import { findByName } from '../categories.ts';
const { posts } = Astro.props;
const fmt = (d) => new Date(d).toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' });
---
<ul class="list">
  {posts.map((post) => {
    const cat = findByName(post.data.category);
    return (
      <li class="entry">
        <a class="entry__thumb" href={`/blog/${post.id}/`} aria-hidden="true" tabindex="-1">
          {post.data.heroImage ? (
            <img src={post.data.heroImage} alt="" width="1200" height="500" loading="lazy" decoding="async" />
          ) : (
            <span class="entry__thumb-blank">{cat ? cat.name : '記録'}</span>
          )}
        </a>

        <div class="entry__body">
          <div class="entry__meta">
            <span class="entry__date">{fmt(post.data.pubDate)}</span>
            {cat && <a class="tag" href={`/category/${cat.slug}/`}>{cat.name}</a>}
          </div>
          <h2 class="entry__title">
            <a href={`/blog/${post.id}/`}>{post.data.title}</a>
          </h2>
          <p class="entry__desc">{post.data.description}</p>
        </div>
      </li>
    );
  })}
</ul>
